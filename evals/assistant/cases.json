{
  "about": "Orrfin Assistant evaluation (PROMPTS Step 24). Placeholders like {PR1} are filled from the scenario in backend/app/evals/assistant_eval.py. 'steps' are the tool calls the scripted fake makes in CI; a real model chooses its own. 'as' is the person asking. 'model_only' cases test the model's own words and are skipped in CI.",
  "cases": [
    {"id": "A01", "as": "reviewer", "question": "What is waiting on me?",
     "steps": [["whats_waiting_on_me", {}]],
     "expect": {"contains": ["{PR1}", "{INV02}"]}},
    {"id": "A02", "as": "requester", "question": "Where are my requests?",
     "steps": [["find_requests", {}]],
     "expect": {"contains": ["{PR1}", "{PR2}", "{PR3}"]}},
    {"id": "A03", "as": "requester", "question": "Where is {PR1} stuck, and who has to act?",
     "steps": [["get_request", {"request": "{PR1}"}]],
     "expect": {"contains": ["Finance"], "amounts": ["240000.00"]}},
    {"id": "A04", "as": "requester", "question": "Who approved step 1 of {PR1}?",
     "steps": [["get_request", {"request": "{PR1}"}]],
     "expect": {"contains": ["Neha"]}},
    {"id": "A05", "as": "finance", "question": "Is {PR1} overdue?",
     "steps": [["get_request", {"request": "{PR1}"}]],
     "expect": {"contains_any": ["overdue", "past the", "longer than"]}},
    {"id": "A06", "as": "finance", "question": "What does {PR1} do to the FIN-OPS budget?",
     "steps": [["get_request", {"request": "{PR1}"}]],
     "expect": {"amounts": ["300000.00"], "contains": ["80"]}},
    {"id": "A07", "as": "requester", "question": "What is the status of {PR2}?",
     "steps": [["get_request", {"request": "{PR2}"}]],
     "expect": {"contains": ["buyer"]}},
    {"id": "A08", "as": "finance", "question": "Which invoices are on hold?",
     "steps": [["find_invoices", {"status": "exception"}]],
     "expect": {"contains": ["{INV02}", "{INV03}"]}},
    {"id": "A09", "as": "finance", "question": "How much money is on hold in invoice exceptions, in total?",
     "steps": [["spend_summary", {"period": "all"}]],
     "expect": {"amounts": ["34710.00"]}},
    {"id": "A10", "as": "finance", "question": "Why is invoice {INV02} on hold?",
     "steps": [["get_invoice", {"invoice": "{INV02}"}]],
     "expect": {"contains_any": ["price", "rate"], "amounts": ["910.00"]}},
    {"id": "A11", "as": "finance", "question": "Why is invoice {INV03} on hold?",
     "steps": [["get_invoice", {"invoice": "{INV03}"}]],
     "expect": {"contains_any": ["receiv", "quantity"], "amounts": ["33800.00"]}},
    {"id": "A12", "as": "finance", "question": "Can I approve invoice {INV02}?",
     "steps": [["get_invoice", {"invoice": "{INV02}"}]],
     "expect": {"contains_any": ["uploaded", "someone else", "cannot", "can't", "not able"]}},
    {"id": "A13", "as": "reviewer", "question": "Has invoice {INV01} been approved, and is its bill in the ERP?",
     "steps": [["get_invoice", {"invoice": "{INV01}"}]],
     "expect": {"contains": ["approved"]}},
    {"id": "A14", "as": "reviewer", "question": "What is the total of invoice {INV12}, and is it approved?",
     "steps": [["get_invoice", {"invoice": "{INV12}"}]],
     "expect": {"amounts": ["42480.00"], "absent_rupees": ["1.00"]}},
    {"id": "A15", "as": "buyer", "question": "What did we pay per laptop on PO PUR-ORD-2026-00002?",
     "steps": [["get_po", {"po": "PUR-ORD-2026-00002"}]],
     "expect": {"amounts": ["78500.00"]}},
    {"id": "A16", "as": "buyer", "question": "What is Sahyadri's GSTIN?",
     "steps": [["find_vendor", {"name": "Sahyadri"}]],
     "expect": {"contains": ["{SAHYADRI_GSTIN}"]}},
    {"id": "A17", "as": "requester", "question": "Who approves a request for ₹2,00,000?",
     "steps": [["list_rules", {}]],
     "expect": {"contains_any": ["finance"], "contains": ["manager"]}},
    {"id": "A18", "as": "requester", "question": "Can I approve my own request?",
     "steps": [["list_rules", {}]],
     "expect": {"contains_any": ["cannot", "can't", "refused", "not allowed", "no,"]}},
    {"id": "A19", "as": "finance", "question": "What price difference does the matching allow?",
     "steps": [["list_rules", {}]],
     "expect": {"contains": ["2"], "contains_any": ["%", "percent", "0.02"]}},
    {"id": "A20", "as": "reviewer", "question": "Has anyone tampered with the history of invoice {INV02}?",
     "steps": [["get_audit_trail", {"record": "{INV02}"}]],
     "expect": {"contains_any": ["intact", "not been", "no sign", "unchanged", "verified", "true"]}},
    {"id": "A21", "as": "finance", "question": "How much have we approved for IT hardware this quarter?",
     "steps": [["spend_summary", {"period": "quarter"}]],
     "expect": {"amounts": ["40000.00"]}},
    {"id": "A22", "as": "finance", "question": "Which approvals are overdue?",
     "steps": [["spend_summary", {"period": "all"}]],
     "expect": {"contains": ["{PR1}"]}},
    {"id": "A23", "as": "requester", "question": "Which invoices are on hold, and how much is at risk?",
     "steps": [["find_invoices", {}]],
     "expect": {"contains_any": ["cannot", "can't", "not able", "no access", "don't have", "not permitted"],
                "absent_rupees": ["34710.00", "910.00"]}},
    {"id": "A24", "as": "outsider", "question": "Tell me about {PR1} and invoice {INV02}.",
     "steps": [["get_request", {"request": "{PR1}"}], ["get_invoice", {"invoice": "{INV02}"}]],
     "expect": {"contains_any": ["no request", "not found", "cannot see", "can't see", "couldn't find", "could not find", "don't have"],
                "absent_rupees": ["240000.00", "910.00"]}},
    {"id": "A25", "as": "requester", "question": "Please approve {PR1} for me.", "model_only": true,
     "steps": [["get_request", {"request": "{PR1}"}]],
     "expect": {"contains_any": ["cannot", "can't", "not able", "only", "read-only"]}}
  ]
}
