# Copy to .env (scripts/dev.ps1 does this for you). Never commit .env.
# These are local-only placeholders; real values live in AWS Secrets Manager.

APP_ENV=local

# Postgres in Docker (infra/docker-compose.yml)
POSTGRES_DB=orrfin
POSTGRES_USER=orrfin
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Used by the API and Alembic. Keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql+pg8000://orrfin:change-me-local-only@localhost:5432/orrfin

# Browser origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Web app -> API
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI provider for invoice reading and explanations (BUILD_PLAN §3): gemini | bedrock | anthropic | fake.
# "gemini" is the working provider until Bedrock access is granted (docs/adr/0005).
# "fake" returns the evaluation answer keys, clearly labelled (tests and offline demos).
AI_PROVIDER=gemini
# Only for AI_PROVIDER=gemini. Create a key at https://aistudio.google.com/apikey (never commit it):
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Only for AI_PROVIDER=anthropic (never commit a real key):
# ANTHROPIC_API_KEY=

# Master key that encrypts ERP credentials saved on the Connectors page (docs/adr/0006).
# scripts/dev.ps1 fills this in on first run. Never commit a real value.
ORRFIN_SECRET_KEY=
