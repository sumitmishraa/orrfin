# Copy to .env (scripts/dev.ps1 does this for you). Never commit .env.
# These are local-only placeholders; real values live in AWS Secrets Manager.

APP_ENV=local

# Postgres in Docker (infra/docker-compose.yml)
POSTGRES_DB=orrfin
POSTGRES_USER=orrfin
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Used by the API and Alembic. Keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql+pg8000://orrfin:change-me-local-only@localhost:5432/orrfin

# Browser origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Web app -> API
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI provider for invoice reading and explanations (BUILD_PLAN §3): bedrock | anthropic | fake.
# "fake" returns the evaluation answer keys, clearly labelled; use it until Bedrock access is granted.
AI_PROVIDER=bedrock
# Only for AI_PROVIDER=anthropic (never commit a real key):
# ANTHROPIC_API_KEY=
